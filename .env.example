# The ChasIX - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/thechasix?sslmode=require

# Schwab API (from developer.schwab.com)
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_app_secret_here
SCHWAB_REFRESH_TOKEN=your_refresh_token_here

# Stripe (from dashboard.stripe.com)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PRICE_ID_PRO_MONTHLY=YOUR_PRICE_ID_HERE

# App settings
SECRET_KEY=change-this-to-a-random-32-char-string
FRONTEND_URL=https://www.thechasix.com
API_URL=https://api.thechasix.com

# Optional: Override for local dev
DEBUG=true
